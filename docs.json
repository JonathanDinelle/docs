{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Veval Docs",
  "description": "Trace, test, and catch regressions in your AI agents.",
  "colors": {
    "primary": "#0b8fb0",
    "light": "#3fe0fb",
    "dark": "#0b8fb0"
  },
  "background": {
    "color": {
      "light": "#f6f5f1",
      "dark": "#060b1c"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter Tight",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "how-veval-works"]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/overview",
              "concepts/traces",
              "concepts/steps",
              "concepts/scenarios",
              "concepts/assertions",
              "concepts/replay",
              "concepts/snapshots"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "quickstart",
              "guides/tracing",
              "guides/scenarios",
              "guides/assertions",
              "guides/replay",
              "guides/snapshots"
            ]
          },
          {
            "group": "Development",
            "pages": ["llm-reference", "ai"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.veval.dev"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"],
    "display": "header"
  },
  "styling": {
    "codeblocks": "system"
  }
}
